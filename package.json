{
  "name": "self-maintaining-apis",
  "version": "0.1.0",
  "private": true,
  "description": "Detects breaking OpenAPI changes, repairs TypeScript consumer code with a validated LLM agent, and opens a pull request.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "demo/api",
    "eval"
  ],
  "engines": {
    "node": ">=22.13.0 <23.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts && npm run typecheck:scenarios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present && npm run test:scripts && npm run test:scenarios",
    "docs": "npm run build -w @sma/core && typedoc",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @sma/server",
    "db:migrate": "npm run db:migrate -w @sma/server",
    "db:reset:test": "npm run db:reset:test -w @sma/server",
    "consumer:install": "npm ci --prefix demo/consumer",
    "consumer:typecheck": "npm run typecheck --prefix demo/consumer",
    "consumer:test:v1": "API_VERSION=v1 npm test --prefix demo/consumer",
    "consumer:test:v2": "API_VERSION=v2 npm test --prefix demo/consumer",
    "typecheck:scripts": "npm run build -w @sma/core && tsc -p scripts/tsconfig.json",
    "test:scripts": "vitest run --root scripts",
    "diagrams": "npm run docs:check && tsx scripts/diagrams/render.ts",
    "acceptance": "npm run build -w @sma/core && tsx scripts/acceptance/run.ts",
    "docs:check": "tsx scripts/diagrams/check.ts",
    "e2e": "npm run build -w @sma/core && npm run e2e -w @sma/web",
    "e2e:real": "npm run build -w @sma/core && npm run e2e:real -w @sma/web",
    "scenarios:build": "tsx scenarios/build.ts",
    "scenarios:verify": "npm run build -w @sma/core && tsx scenarios/verify.ts",
    "typecheck:scenarios": "tsc -p scenarios/tsconfig.json",
    "test:scenarios": "vitest run --root scenarios",
    "eval": "npm run build -w @sma/core && tsx eval/run.ts",
    "eval:report": "npm run build -w @sma/core && tsx eval/report.ts",
    "eval:review": "npm run build -w @sma/core && tsx eval/review.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "puppeteer": "25.16.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
