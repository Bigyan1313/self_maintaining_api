{
  "name": "@sma/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify HTTP API and pipeline orchestrator.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:core": "npm run build -w @sma/core",
    "dev": "tsx watch src/main.ts",
    "predev": "npm run build:core",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run build:core",
    "test": "vitest run",
    "pretest": "npm run build:core",
    "db:generate": "drizzle-kit generate",
    "predb:generate": "npm run build:core",
    "db:migrate": "drizzle-kit migrate",
    "predb:migrate": "npm run build:core",
    "db:reset:test": "tsx src/infra/db/reset-test-db.ts",
    "predb:reset:test": "npm run build:core"
  },
  "dependencies": {
    "@sma/core": "0.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
