# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose and the server)
POSTGRES_USER=sma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sma
POSTGRES_PORT=5432
DATABASE_URL=postgres://sma:change-me@localhost:5432/sma
# Optional. Tests use DATABASE_URL with the database name replaced by sma_test.
# If set, the name must end in _test (tests drop and recreate it).
# TEST_DATABASE_URL=postgres://sma:change-me@localhost:5432/sma_test

# GitHub token used by Delivery (Increment 12) to push branches and open PRs
GITHUB_TOKEN=
# Optional: owner/name of the demo consumer repo for the live delivery smoke test (opens a real PR, never merged)
# SMA_DEMO_REPO=Bigyan1313/sma-demo-consumer

# LLM provider (used only by apps/server/src/infra/llm/adapter.ts, Increment 10)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Maximum tokens per repair run; exceeding it aborts the run (FR-24)
RUN_TOKEN_CEILING=200000

# Optional: API_VERSION passed into the validation container (the demo consumer uses v1/v2 fixtures)
# SMA_VALIDATOR_API_VERSION=v2
