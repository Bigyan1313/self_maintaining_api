{
  "name": "@sma/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain logic: ingest, detect-parse, classify, locate, guards, types. No network, Docker, or LLM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api/contract": {
      "types": "./dist/api/contract.d.ts",
      "default": "./dist/api/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
